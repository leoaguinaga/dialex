---
// src/components/Certifications.astro
---

<section class="w-full bg-surface-container-low py-space-3xl" id="certificaciones">
  <div class="max-w-7xl mx-auto px-container-padding-desktop">
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-space-2xl">
      <span class="inline-flex items-center gap-1 px-space-sm py-1 rounded-full bg-surface-container-highest text-primary text-label-md uppercase tracking-wider mb-space-xs font-bold">
        Respaldados por el Ministerio de Salud
      </span>
      <h2 class="text-headline-xl text-on-surface tracking-tight font-bold">
        CALIDAD GARANTIZADA: Certificaciones Oficiales DIGEMID
      </h2>
      <p class="text-body-lg text-on-surface-variant mt-space-xs leading-relaxed">
        Contamos con las certificaciones otorgadas por la Dirección General de Medicamentos, Insumos y Drogas (DIGEMID - MINSA Perú) que avalan nuestras instalaciones y flota:
      </p>
    </div>

    <!-- Certifications Showcase Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-space-xl">
      <!-- Card 1: BPA -->
      <div class="bg-surface-container-lowest rounded-2xl p-space-xl shadow-md flex flex-col justify-between relative overflow-hidden group hover:shadow-xl transition-all border border-surface-container-high/40">
        <div class="absolute -top-12 -right-12 w-36 h-36 bg-surface-variant/40 rounded-full blur-2xl pointer-events-none"></div>
        <div>
          <div class="flex items-center justify-between gap-space-md mb-space-md">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-primary-fixed to-primary-container flex items-center justify-center shadow-md">
              <svg class="w-10 h-10 text-on-primary" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"></path>
              </svg>
            </div>
            <span class="inline-flex items-center gap-1 bg-surface-container px-3 py-1 rounded-full text-label-sm font-bold text-primary">
              <span class="material-symbols-outlined text-[16px]">verified_user</span>
              Almacén Central
            </span>
          </div>
          <div class="flex flex-wrap items-baseline gap-space-xs mb-space-xs">
            <h3 class="text-headline-lg font-bold text-on-surface">BPA</h3>
            <span class="text-label-lg text-primary font-semibold">Buenas Prácticas de Almacenamiento</span>
          </div>
          <p class="text-body-sm text-on-surface-variant mb-space-md leading-relaxed">
            Good Practice Storage (GPS) — Certificación que valida el acondicionamiento térmico, humedad controlada e infraestructura calificada para la conservación idónea del principio activo de cada medicamento.
          </p>
          <ul class="space-y-space-xs text-body-sm text-on-surface">
            <li class="flex items-start gap-space-xs">
              <span class="material-symbols-outlined text-tertiary text-[18px] shrink-0 mt-0.5">check_circle</span>
              <span>Monitoreo 24/7 de temperatura (15°C a 25°C y Cadena de Frío 2°C a 8°C).</span>
            </li>
            <li class="flex items-start gap-space-xs">
              <span class="material-symbols-outlined text-tertiary text-[18px] shrink-0 mt-0.5">check_circle</span>
              <span>Zonas de cuarentena, embalaje esterilizado y control de rotación FIFO / FEFO.</span>
            </li>
            <li class="flex items-start gap-space-xs">
              <span class="material-symbols-outlined text-tertiary text-[18px] shrink-0 mt-0.5">check_circle</span>
              <span>Dirección Técnica Farmacéutica permanente en planta.</span>
            </li>
          </ul>
        </div>
        <div class="mt-space-lg pt-space-sm bg-surface-container-low p-space-sm rounded-xl flex items-center justify-between">
          <span class="text-label-sm text-on-surface-variant font-mono">RESOLUCIÓN N° 4892-2022/DIGEMID</span>
          <span class="inline-flex items-center gap-1 text-primary text-label-sm font-bold">
            <span class="material-symbols-outlined text-[16px]">verified</span> VIGENTE
          </span>
        </div>
      </div>

      <!-- Card 2: BPDT -->
      <div class="bg-surface-container-lowest rounded-2xl p-space-xl shadow-md flex flex-col justify-between relative overflow-hidden group hover:shadow-xl transition-all border border-surface-container-high/40">
        <div class="absolute -top-12 -right-12 w-36 h-36 bg-tertiary-fixed/30 rounded-full blur-2xl pointer-events-none"></div>
        <div>
          <div class="flex items-center justify-between gap-space-md mb-space-md">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-tertiary to-tertiary-container flex items-center justify-center shadow-md">
              <svg class="w-10 h-10 text-on-tertiary" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-2 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"></path>
              </svg>
            </div>
            <span class="inline-flex items-center gap-1 bg-surface-container px-3 py-1 rounded-full text-label-sm font-bold text-tertiary">
              <span class="material-symbols-outlined text-[16px]">local_shipping</span>
              Flota Certificada
            </span>
          </div>
          <div class="flex flex-wrap items-baseline gap-space-xs mb-space-xs">
            <h3 class="text-headline-lg font-bold text-on-surface">BPDT</h3>
            <span class="text-label-lg text-tertiary font-semibold">Buenas Prácticas de Distribución y Transporte</span>
          </div>
          <p class="text-body-sm text-on-surface-variant mb-space-md leading-relaxed">
            Good Practices Distribution and Transportation (GPDT) — Asegura la inviolabilidad, trazabilidad GPS y condiciones climáticas del medicamento desde nuestro almacén hasta la puerta de tu botica.
          </p>
          <ul class="space-y-space-xs text-body-sm text-on-surface">
            <li class="flex items-start gap-space-xs">
              <span class="material-symbols-outlined text-tertiary text-[18px] shrink-0 mt-0.5">check_circle</span>
              <span>Vehículos isotérmicos con datalogger y calibración certificada.</span>
            </li>
            <li class="flex items-start gap-space-xs">
              <span class="material-symbols-outlined text-tertiary text-[18px] shrink-0 mt-0.5">check_circle</span>
              <span>Despacho con precinto de seguridad codificado y guía de remisión electrónica.</span>
            </li>
            <li class="flex items-start gap-space-xs">
              <span class="material-symbols-outlined text-tertiary text-[18px] shrink-0 mt-0.5">check_circle</span>
              <span>Personal logístico capacitado periódicamente en normativas sanitarias.</span>
            </li>
          </ul>
        </div>
        <div class="mt-space-lg pt-space-sm bg-surface-container-low p-space-sm rounded-xl flex items-center justify-between">
          <span class="text-label-sm text-on-surface-variant font-mono">RESOLUCIÓN N° 4893-2022/DIGEMID</span>
          <span class="inline-flex items-center gap-1 text-tertiary text-label-sm font-bold">
            <span class="material-symbols-outlined text-[16px]">verified</span> VIGENTE
          </span>
        </div>
      </div>
    </div>

    <!-- Photo Evidence Banner -->
    <div class="mt-space-xl p-space-lg rounded-2xl bg-surface-container-lowest shadow-sm flex flex-col md:flex-row items-center gap-space-lg border border-surface-container-high/40">
      <div class="w-full md:w-48 h-32 rounded-xl overflow-hidden shrink-0">
        <img
          alt="Profesional farmacéutica verificando inventario con tablet en botica de Lima Perú"
          class="w-full h-full object-cover"
          referrerpolicy="no-referrer"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuD25BRHJw8cZKaLHkDzi6zGDWPFijl653Zgm1mGKZUiKG4KJrSmwN2DvcdNUb821BJczeseIawQ1GexbdvHYIZKHYOZ3g6PY_khrKCyJSyDPNsYEKMkX7RQfHI2GIVuKTlVIu-YLItPgAn8aUOI2G7B3s7ylgwuosypiBmvyNLYzlEnJ2yG9Q6Y8JynXZKLxxM4BGxw5GwhrCY3dQnGTakvQ9Tk6E0qOwnokT-fZCzK4ITWbG4xt_AjXA"
        />
      </div>
      <div class="flex-1">
        <h4 class="text-headline-sm font-bold text-on-surface">Capacitación y Auditoría Continua</h4>
        <p class="text-body-md text-on-surface-variant mt-1 leading-relaxed">
          En Grupo Dialex realizamos auditorías cruzadas trimestrales y jornadas formativas obligatorias para todo el equipo operativo, garantizando que cada blíster y ampolla cumpla la estricta reglamentación sanitaria peruana.
        </p>
      </div>
      <a
        href="#cotizacion-b2b"
        class="shrink-0 inline-flex items-center gap-space-xs text-primary text-label-lg hover:text-primary-container font-bold group"
      >
        <span>Solicitar expediente de calidad</span>
        <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
      </a>
    </div>
  </div>
</section>
