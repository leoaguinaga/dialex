---
// src/components/Header.astro
const navLinks = [
  { label: "Inicio", href: "#inicio", active: true },
  { label: "Certificaciones (BPA/BPDT)", href: "#certificaciones" },
  { label: "Nosotros", href: "#nosotros" },
  { label: "Catálogo Farmacéutico", href: "#catalogo" },
  { label: "Trabaja con Nosotros", href: "#contacto" },
];
---

<header
  class="fixed top-0 w-full z-50 shadow-[0_1px_8px_rgba(11,28,48,0.06)]"
  id="header-nav"
>
  <!-- Top Announcement Bar -->
  <div
    class="bg-inverse-surface text-inverse-on-surface py-space-xs hidden lg:block"
  >
    <div
      class="max-w-7xl mx-auto px-container-padding-desktop flex flex-wrap items-center justify-between gap-space-sm"
    >
      <div class="flex items-center gap-space-lg">
        <div class="hidden md:flex items-center gap-space-xs text-body-sm">
          <span
            class="material-symbols-outlined text-inverse-primary text-[10px]"
            >schedule</span
          >
          <span>Lun - Sáb: 7:30 AM - 7:00 PM</span>
        </div>
        <div class="hidden md:flex items-center gap-space-xs text-body-sm">
          <span
            class="material-symbols-outlined text-inverse-primary text-[10px]"
            >call</span
          >
          <span>Central Pedidos: (01) 748-3900 / +51 984 210 330</span>
        </div>
      </div>
      <div class="flex items-center gap-space-md">
        <span
          class="inline-flex items-center gap-space-xs bg-tertiary-container text-on-tertiary-container px-space-sm py-1.5 rounded-full text-label-sm uppercase tracking-wider font-bold"
        >
          Certificados por DIGEMID (BPA / BPDT)
        </span>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="bg-surface/90 backdrop-blur-xl border-b border-surface-dim/40">
    <div
      class="h-20 max-w-7xl mx-auto px-container-padding-desktop flex items-center justify-between gap-space-md"
    >
      <!-- Brand Logo -->
      <a href="#inicio" class="flex items-center">
        <img
          src="/images/brand/logo-alt.png"
          alt="Grupo Dialex"
          class="h-8 w-full object-contain sm:h-5.25"
        />
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-space-lg" id="desktop-nav">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                "nav-link-desktop py-space-xs transition-colors",
                link.active
                  ? "text-primary font-bold"
                  : "text-label-lg text-on-surface-variant hover:text-primary font-medium",
              ]}
              aria-current={link.active ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <!-- Desktop CTAs & Mobile Hamburger -->
      <div class="flex items-center gap-space-md">
        <a
          href="https://wa.me/51984210330?text=Hola%20Grupo%20Dialex,%20deseo%20hacer%20un%20pedido%20B2B"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-space-xs bg-primary text-on-tertiary hover:bg-tertiary-container hover:text-on-tertiary-container px-space-md py-2.5 rounded-lg text-label-lg font-bold transition-all shadow-sm"
        >
          <span>Haz tu Pedido</span>
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-button"
          type="button"
          aria-label="Abrir menú de navegación"
          class="lg:hidden size-11 inline-flex items-center justify-center text-on-surface hover:text-primary rounded-lg focus:outline-none focus:ring-2 focus:ring-primary cursor-pointer"
        >
          <span class="material-symbols-outlined text-[28px]" id="menu-icon"
            >menu</span
          >
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Drawer -->
    <div
      id="mobile-menu"
      class="hidden lg:hidden border-t border-surface-container bg-surface px-container-padding-mobile py-space-md"
    >
      <nav class="flex flex-col gap-space-sm" id="mobile-nav">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                "nav-link-mobile min-h-11 flex items-center px-space-sm py-2 rounded-lg transition-colors",
                link.active
                  ? "bg-surface-container text-primary font-bold"
                  : "text-on-surface-variant hover:bg-surface-container-low hover:text-primary font-medium",
              ]}
              aria-current={link.active ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
        <div
          class="pt-space-xs border-t border-surface-dim/40 flex flex-col gap-2 mt-1"
        >
          <a
            href="https://wa.me/51984210330?text=Hola%20Grupo%20Dialex,%20deseo%20hacer%20un%20pedido%20B2B"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-space-xs bg-primary text-on-tertiary py-2.5 rounded-lg text-label-lg font-bold"
          >
            <span>Haz tu Pedido</span>
          </a>
          <div
            class="flex items-center gap-2 px-space-sm py-1 text-body-sm text-on-surface-variant"
          >
            <span class="material-symbols-outlined text-primary text-[18px]"
              >call</span
            >
            <span>(01) 748-3900 / +51 984 210 330</span>
          </div>
          <div class="flex items-center gap-space-xs text-body-sm px-space-sm">
            <span
              class="material-symbols-outlined text-primary text-[18px]"
              >schedule</span
            >
            <span>Lun - Sáb: 7:30 AM - 7:00 PM</span>
          </div>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  const icon = document.getElementById("menu-icon");

  if (button && menu && icon) {
    button.addEventListener("click", () => {
      const isHidden = menu.classList.contains("hidden");
      if (isHidden) {
        menu.classList.remove("hidden");
        icon.textContent = "close";
      } else {
        menu.classList.add("hidden");
        icon.textContent = "menu";
      }
    });

    // Close mobile menu when clicking navigation link
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.add("hidden");
        icon.textContent = "menu";
      });
    });
  }

  // ScrollSpy for Desktop and Mobile Navigation
  const sectionIds = ["inicio", "certificaciones", "nosotros", "catalogo", "contacto"];

  function getSections(): HTMLElement[] {
    return sectionIds
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null)
      .sort((a, b) => a.offsetTop - b.offsetTop);
  }

  function setActive(activeId: string) {
    // Update Desktop Navigation
    const desktopLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link-desktop");
    desktopLinks.forEach((link) => {
      const href = link.getAttribute("href");
      const isCurrent = href === `#${activeId}`;
      if (isCurrent) {
        link.classList.add("text-primary", "font-bold");
        link.classList.remove("text-label-lg", "text-on-surface-variant", "font-medium");
        link.setAttribute("aria-current", "page");
      } else {
        link.classList.remove("text-primary", "font-bold");
        link.classList.add("text-label-lg", "text-on-surface-variant", "font-medium");
        link.removeAttribute("aria-current");
      }
    });

    // Update Mobile Navigation
    const mobileLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link-mobile");
    mobileLinks.forEach((link) => {
      const href = link.getAttribute("href");
      const isCurrent = href === `#${activeId}`;
      if (isCurrent) {
        link.classList.add("bg-surface-container", "text-primary", "font-bold");
        link.classList.remove("text-on-surface-variant", "hover:bg-surface-container-low", "font-medium");
        link.setAttribute("aria-current", "page");
      } else {
        link.classList.remove("bg-surface-container", "text-primary", "font-bold");
        link.classList.add("text-on-surface-variant", "hover:bg-surface-container-low", "font-medium");
        link.removeAttribute("aria-current");
      }
    });
  }

  function onScroll() {
    const sections = sectionIds
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    if (!sections.length) return;

    const scrollY = window.scrollY;
    const headerNav = document.getElementById("header-nav");
    const headerHeight = headerNav ? headerNav.offsetHeight : 110;
    const windowHeight = window.innerHeight;
    const docHeight = document.documentElement.scrollHeight;

    // Bottom of the page: activate the last section ("contacto")
    if (scrollY + windowHeight >= docHeight - 80) {
      setActive("contacto");
      return;
    }

    // Top of the page: activate "inicio"
    if (scrollY < 100) {
      setActive("inicio");
      return;
    }

    // Measure each section's actual top relative to document
    const sectionPositions = sections
      .map((sec) => ({
        id: sec.id,
        top: sec.getBoundingClientRect().top + scrollY,
      }))
      .sort((a, b) => a.top - b.top);

    const triggerY = scrollY + headerHeight + 60;
    let currentId = sectionPositions[0].id;

    for (const sec of sectionPositions) {
      if (triggerY >= sec.top) {
        currentId = sec.id;
      }
    }

    setActive(currentId);
  }

  // Click on nav links gives immediate active response
  document.querySelectorAll<HTMLAnchorElement>(".nav-link-desktop, .nav-link-mobile").forEach((link) => {
    link.addEventListener("click", () => {
      const href = link.getAttribute("href");
      if (href && href.startsWith("#")) {
        const targetId = href.substring(1);
        setActive(targetId);
      }
    });
  });

  // Passive scroll listener throttled with requestAnimationFrame
  let ticking = false;
  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          onScroll();
          ticking = false;
        });
        ticking = true;
      }
    },
    { passive: true }
  );

  window.addEventListener("resize", onScroll, { passive: true });

  // Initial check
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", onScroll);
  } else {
    onScroll();
  }
</script>
