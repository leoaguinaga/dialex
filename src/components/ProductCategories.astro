<section class="w-full bg-surface-container-low py-space-3xl scroll-mt-28" id="catalogo">
  <div class="max-w-7xl mx-auto px-container-padding-desktop">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-space-2xl">
      <span class="text-label-md uppercase tracking-wider text-primary font-bold">Portafolio Farmacéutico Completo</span>
      <h2 class="text-headline-xl text-on-surface tracking-tight font-bold mt-space-2xs">
        Categorías de Productos más Solicitados
      </h2>
      <p class="text-body-md text-on-surface-variant mt-space-xs leading-relaxed">
        Comercializamos líneas éticas, genéricos intercambiables y suministros de los principales laboratorios nacionales e internacionales.
      </p>
    </div>

    <!-- 5-Category Bento Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-space-md">
      {categories.map((cat) => (
        <a
          href="#cotizacion-b2b"
          class="bg-surface-container-lowest rounded-2xl p-space-md shadow-sm hover:shadow-lg transition-all flex flex-col justify-between group border border-surface-container-high/40"
        >
          <div>
            <div class="h-32 w-full rounded-xl overflow-hidden mb-space-sm bg-surface-container">
              <img
                src={cat.image}
                alt={cat.imageAlt}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                referrerpolicy="no-referrer"
              />
            </div>
            <span class="text-label-sm text-primary font-bold uppercase">{cat.tag}</span>
            <h3 class="text-headline-sm font-bold text-on-surface mt-1 leading-snug">{cat.title}</h3>
            <p class="text-body-sm text-on-surface-variant mt-1 leading-relaxed">{cat.description}</p>
          </div>
          <div class="mt-space-md flex items-center justify-between text-label-sm text-primary font-bold">
            <span>{cat.count}</span>
            <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Interactive Wholesale Catalog Banner -->
    <div class="mt-space-xl p-space-xl rounded-2xl bg-gradient-to-r from-inverse-surface via-primary to-primary-container text-on-primary flex flex-col lg:flex-row items-center justify-between gap-space-lg shadow-lg">
      <div class="flex flex-col md:flex-row items-start md:items-center gap-space-md">
        <div class="w-14 h-14 rounded-2xl bg-surface-container-lowest/10 backdrop-blur-md flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-[32px] text-inverse-primary">download</span>
        </div>
        <div>
          <h3 class="text-headline-md font-bold leading-tight">¿Buscas abastecer tu farmacia hoy mismo?</h3>
          <p class="text-body-md text-surface-container-highest/90 mt-1 max-w-xl leading-relaxed">
            Descarga nuestro Catálogo Mayorista en formato PDF con especificaciones, presentaciones por caja y vigencia de lote o cotiza en línea al instante.
          </p>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-space-sm shrink-0 w-full sm:w-auto">
        <a
          href="https://wa.me/51984210330?text=Hola%20Dialex,%20deseo%20descargar%20el%20catalogo%20mayorista%20actualizado"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-space-xs bg-surface-container-lowest text-primary hover:bg-surface-container px-space-lg py-3 rounded-lg text-label-lg font-bold transition-colors shadow-sm w-full sm:w-auto"
        >
          <span class="material-symbols-outlined text-[20px]">picture_as_pdf</span>
          <span>Descargar Catálogo (PDF)</span>
        </a>
        <a
          href="#cotizacion-b2b"
          class="inline-flex items-center justify-center gap-space-xs bg-tertiary text-on-tertiary hover:bg-tertiary-container px-space-md py-3 rounded-lg text-label-lg font-bold transition-colors shadow-sm w-full sm:w-auto"
        >
          <span class="material-symbols-outlined text-[20px]">shopping_cart_checkout</span>
          <span>Comprar al Por Mayor</span>
        </a>
      </div>
    </div>
  </div>
</section>
