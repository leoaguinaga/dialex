---
// src/components/WhyChooseUs.astro
const pillars = [
  {
    icon: 'inventory',
    title: 'Stock Permanente y Alta Rotación',
    description:
      'Disponibilidad ininterrumpida de analgésicos, antibióticos, antihistamínicos y genéricos esenciales para evitar el quiebre de stock en mostrador.',
    tagIcon: 'bolt',
    tagText: 'Rotación garantizada',
    isTertiary: false,
  },
  {
    icon: 'person_check',
    title: 'Asesoría Comercial Personalizada',
    description:
      'Un ejecutivo farmacéutico asignado a tu cuenta para orientarte en combos de temporada, compras sugeridas y maximización de margen bruto.',
    tagIcon: 'groups',
    tagText: 'Acompañamiento 1 a 1',
    isTertiary: false,
  },
  {
    icon: 'local_shipping',
    title: 'Entregas Puntuales y Seguras',
    description:
      'Rutas programadas en Lima Metropolitana y despachos a través de agencias consolidadas de confianza para todas las regiones del interior.',
    tagIcon: 'schedule',
    tagText: 'Puntualidad certificada',
    isTertiary: false,
  },
  {
    icon: 'savings',
    title: 'Precios Competitivos Mayoristas',
    description:
      'Escalas por volumen, bonificaciones por laboratorio y condiciones comerciales flexibles para boticas independientes y cadenas medianas.',
    tagIcon: 'percent',
    tagText: 'Rentabilidad para tu botica',
    isTertiary: true,
  },
];
---

<section class="max-w-7xl mx-auto px-container-padding-desktop py-space-3xl" id="nosotros">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md mb-space-2xl">
    <div>
      <span class="text-label-md uppercase tracking-wider text-primary font-bold">Ventaja Comercial B2B</span>
      <h2 class="text-headline-xl text-on-surface tracking-tight font-bold mt-space-2xs">
        ¿Por qué las boticas eligen a Grupo Dialex?
      </h2>
    </div>
    <p class="text-body-md text-on-surface-variant max-w-md leading-relaxed">
      Entendemos las necesidades de flujo de caja y demanda diaria de farmacias independientes y clínicas peruanas.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-lg">
    {pillars.map((pillar) => (
      <div class="p-space-lg rounded-2xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between border border-surface-container-high/40">
        <div>
          <div class:list={[
            'w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center mb-space-md',
            pillar.isTertiary ? 'text-tertiary' : 'text-primary'
          ]}>
            <span class="material-symbols-outlined text-[26px]">{pillar.icon}</span>
          </div>
          <h3 class="text-headline-sm font-bold text-on-surface mb-space-xs leading-snug">
            {pillar.title}
          </h3>
          <p class="text-body-md text-on-surface-variant leading-relaxed">
            {pillar.description}
          </p>
        </div>
        <div class:list={[
          'mt-space-md pt-space-xs text-label-sm font-bold flex items-center gap-1',
          pillar.isTertiary ? 'text-tertiary' : 'text-primary'
        ]}>
          <span class="material-symbols-outlined text-[16px]">{pillar.tagIcon}</span>
          <span>{pillar.tagText}</span>
        </div>
      </div>
    ))}
  </div>
</section>
