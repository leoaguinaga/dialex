---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Certifications from '../components/Certifications.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import ProductCategories from '../components/ProductCategories.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import TestimonialsAndTrust from '../components/TestimonialsAndTrust.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
	<Header />
	<main class="w-full pt-28 sm:pt-32 bg-background flex flex-col">
		<Hero />
		<Certifications />
		<WhyChooseUs />
		<ProductCategories />
		<ProcessSteps />
		<TestimonialsAndTrust />
		<QuoteForm />
	</main>
	<Footer />
</Layout>
